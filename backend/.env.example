# Google OAuth2 클라이언트 (Google Cloud Console → API 및 서비스 → 사용자 인증 정보)
# 승인된 리디렉션 URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# HS256 서명 키 (최소 32바이트). 반드시 채워야 하며, 비어 있으면 서버가 기동하지 않는다.
# 폴백 기본값을 두지 않는 이유: 공개 저장소에 적힌 키로 서명하게 되면 누구나 토큰을 위조할 수 있다.
#   openssl rand -base64 48
JWT_SECRET=

# DB 접속 정보 — 비워두면 docker-compose 로컬 DB 기본값(earth/earth)을 쓴다.
# 운영에서는 반드시 지정할 것.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# CORS 허용 오리진 / OAuth 성공 후 프론트 리다이렉트 주소
FRONTEND_ORIGIN=http://localhost:5173
OAUTH_REDIRECT_URL=http://localhost:5173/oauth2/redirect
