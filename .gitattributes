# 기본: 텍스트 파일은 저장소에 LF로 정규화 (작업 트리는 플랫폼 기본값 따름)
* text=auto

# 셸 스크립트는 작업 트리에서도 반드시 LF — CRLF면 셔뱅(#!/bin/sh)이 깨진다
gradlew    text eol=lf
*.sh       text eol=lf

# 윈도우 배치 파일은 CRLF 유지
*.bat      text eol=crlf
*.cmd      text eol=crlf

# 바이너리 (줄바꿈 변환 금지)
*.jar      binary
*.png      binary
*.jpg      binary
*.ico      binary
*.woff     binary
*.woff2    binary
