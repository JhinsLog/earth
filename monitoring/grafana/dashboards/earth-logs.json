{
  "uid": "earth-logs",
  "title": "Earth 로그",
  "tags": [
    "earth"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "userId",
        "label": "사용자 ID",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": [
          {
            "selected": true,
            "text": ".*",
            "value": ".*"
          }
        ]
      },
      {
        "type": "textbox",
        "name": "sessionId",
        "label": "세션 ID",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": [
          {
            "selected": true,
            "text": ".*",
            "value": ".*"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "오류",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "브라우저 오류 (선택 기간)",
      "description": "사용자 브라우저에서 난 오류 수. 화면 굳음(GPU 연결 끊김), 자바스크립트 예외, API 실패가 여기 잡힌다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({stream=\"client\", level=\"WARN\"} [$__range]))",
          "queryType": "instant",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 2
    },
    {
