    {
      "type": "logs",
      "title": "사용자 추적 (위 변수로 거름)",
      "description": "상단의 사용자 ID·세션 ID 칸에 값을 넣으면 그 사람의 서버 행동과 화면 행동·오류가 시간순으로 섞여 나온다. 비워 두면(.*) 전체다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 58,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{stream=~\"activity|client\"} | json | userId=~\"$userId\" | sessionId=~\"$sessionId\" | line_format \"{{if .action}}[서버] {{.action}} → {{.status}}{{.result}}{{else}}[화면] {{.kind}} {{.name}} {{.errorMessage}}{{end}}  user={{.userId}} session={{.sessionId}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      },
      "id": 16
    },
    {
      "type": "logs",
      "title": "실패한 행동",
      "description": "상태 코드 400 이상이거나 채팅이 거절된 기록.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 70,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{stream=\"activity\"} | json | status >= 400 or (result != \"\" and result != \"ok\")",
          "queryType": "range"
