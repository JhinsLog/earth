      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (name, gpu, viewport) (count_over_time({stream=\"client\", level=\"WARN\"} | json [$__range]))",
          "queryType": "instant",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "name": "오류",
              "gpu": "GPU",
              "viewport": "화면 크기",
              "Value": "건수"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "건수",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "id": 8
    },
    {
      "type": "logs",
      "title": "최근 브라우저 오류",
      "description": "한 줄을 펼치면 스택·브라우저·사용자·세션까지 전부 보인다. 세션 ID를 복사해 아래 '사용자 추적'에 넣으면 그 오류 직전에 무엇을 했는지 이어 볼 수 있다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{stream=\"client\", level=\"WARN\"} | json | line_format \"{{.name}}  {{.errorMessage}}  [{{.gpu}} · {{.viewport}}]  session={{.sessionId}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      },
      "id": 9
    },
